# Configuración opcional para correr la ingesta desde el host contra el bucket real.
# Copiar a `.env` (está en .gitignore) y completar. En AWS este archivo no existe: los
# jobs de Glue reciben los mismos valores como argumentos que les pasa Terraform.
#
# Acá no van credenciales de AWS: boto3 las toma de `~/.aws`.

# Región de la cuenta y bucket del lakehouse; los dos salen de `terraform output`.
S3_REGION=us-east-1
S3_LANDING_BUCKET=oil-lakehouse-000000000000-dev
# Prefijo de la zona landing: el mismo bucket guarda además warehouse/ y artifacts/.
S3_LANDING_PREFIX=landing

# Manifiesto de ingesta (Postgres en Neon). Alcanza con uno de los dos:
# el DSN en claro, que es lo cómodo desde el host...
POSTGRES_DSN=postgresql://usuario:password@ep-ejemplo.neon.tech/lakehouse?sslmode=require
# ...o el nombre del parámetro SecureString de SSM que lo guarda, que es lo que usan los
# jobs (`terraform output postgres_dsn_ssm_parameter`). Si el DSN está vacío se lee de ahí.
POSTGRES_DSN_SSM_PARAMETER=/oil-lakehouse/dev/postgres_dsn

# Portal de datos abiertos de Energía. En http: https redirige 301 a http.
CKAN_BASE_URL=http://datos.energia.gob.ar
